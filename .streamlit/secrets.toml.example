# Modèle des secrets pour la version en ligne (Streamlit Community Cloud : Settings > Secrets).
# Ne mettez JAMAIS la vraie clé dans ce fichier : il est publié. Collez-la seulement dans
# l'interface de l'hébergeur. Les clés de premier niveau y deviennent des variables d'environnement.
MODEL_API_KEY = "LLM|xxxxxxxx|xxxxxxxxxxxxxxxx"
DEAL_COPILOT_DB = "session"          # une base en mémoire par visiteur
DEAL_COPILOT_MAX_ACTIONS = "25"      # actions qui appellent Muse, par visite
